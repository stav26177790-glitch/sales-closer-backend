# Провайдер моделей (llm/provider.js): anthropic (Claude) или deepseek
LLM_PROVIDER=deepseek
# Ключ DeepSeek (https://platform.deepseek.com → API keys) — пользователи бэкенда его не видят
DEEPSEEK_API_KEY=sk-...
# Ключ Anthropic — только если LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

PORT=3001
